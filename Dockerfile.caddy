FROM caddy:2-builder@sha256:cda07fe9d82728c7ac44d844306d435e98131423dc7b114f05a8a8ecfff94707 AS builder

# Patch the network library until the official image includes this security update.
RUN xcaddy build v2.11.9 --replace golang.org/x/net=golang.org/x/net@v0.62.0

FROM caddy:2@sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
# High internal ports do not need the official binary's low-port capability.
RUN setcap -r /usr/bin/caddy \
    && chown -R 10001:10001 /data /config \
    && chmod 700 /data/caddy /config/caddy
USER 10001:10001
