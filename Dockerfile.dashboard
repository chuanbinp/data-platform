FROM python:3.12-slim-bookworm@sha256:44cf1793efa7c7a476bb0f2cff81443f4a072c90c1cb127e2924933daa3e8c64

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/data-platform/.venv/bin:$PATH
WORKDIR /opt/data-platform

COPY pyproject.toml uv.lock ./
COPY src ./src
RUN pip install --no-cache-dir uv==0.13.9 \
    && uv sync --locked --extra dashboard --no-default-groups --no-dev --no-editable \
    && useradd --uid 10001 --create-home viewer

USER viewer
EXPOSE 8080
CMD ["uvicorn", "data_platform.dashboard.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--limit-concurrency", "32", "--no-access-log"]
