POSTGRES_DB=warehouse
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-local-development-only
POSTGRES_PORT=5000

# Register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Airflow UI: http://localhost:8000
AIRFLOW_PORT=8000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-local-development-only
AIRFLOW_JWT_SECRET=change-me-local-airflow-jwt-secret-use-a-random-long-value-before-deployment

# Optional dbt schemas (defaults shown)
DBT_BRONZE_SCHEMA=bronze
DBT_SILVER_SCHEMA=silver
DBT_GOLD_SCHEMA=gold

# Read-only explorer: http://localhost:8050
DASHBOARD_PORT=8050
VIEWER_USER=warehouse_viewer
VIEWER_PASSWORD=replace-with-a-separate-random-password
