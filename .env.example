POSTGRES_DB=warehouse
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_PORT=5000

# Private GCS bucket for daily full Postgres backups.
BACKUP_BUCKET=data-platform-pg-backups

# Separate runtime accounts; POSTGRES_USER is for administration only.
WAREHOUSE_USER=warehouse_writer
WAREHOUSE_PASSWORD=
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=

# Register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Airflow UI: http://localhost:8000
AIRFLOW_PORT=8000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=

# Optional dbt schemas (defaults shown)
DBT_BRONZE_SCHEMA=bronze
DBT_SILVER_SCHEMA=silver
DBT_GOLD_SCHEMA=gold

# Read-only explorer: http://localhost:8080
DASHBOARD_PORT=8080
VIEWER_USER=warehouse_viewer
VIEWER_PASSWORD=
